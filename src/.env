# Local environment variables for development
# Copy values from .env.example and fill in real credentials before use.

# SMTP settings (used by api/send-contact.ts)
# For Gmail, create an App Password and use it as SMTP_PASS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=change_me_secure_password
SMTP_SECURE=false

# Optional: destination email for contact form
CONTACT_TO=norhene.chalghoumi@gmail.com

# NODE_ENV is optional for local dev
NODE_ENV=development

